FROM python:3.14-slim

WORKDIR /app

# Install uv
RUN pip install --no-cache-dir uv

# Copy project files
COPY pyproject.toml pyrightconfig.json README.md ./
COPY src ./src

# Install Python dependencies using uv
RUN uv sync --no-dev --no-group dev

# Run Telegram bot
CMD ["uv", "run", "python", "-m", "semantic_search_service.bot.main"]