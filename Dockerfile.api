FROM python:3.14-slim

WORKDIR /app

# Install uv
RUN pip install --no-cache-dir uv

# Copy project files
COPY pyproject.toml pyrightconfig.json README.md ./
COPY src ./src

# Install Python dependencies using uv
RUN uv sync --no-dev --no-group dev

# Expose port for API
EXPOSE 8000

# Run FastAPI server
CMD ["uv", "run", "uvicorn", "semantic_search_service.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]